# Reference only. Spring Boot and run-dev.sh do NOT automatically source .env.
# Supply actual values through your process environment or secret manager.
RAG_ENVIRONMENT=development
RAG_BIND_ADDRESS=127.0.0.1
RAG_PORT=18084
RAG_WORKSPACE_ID=org-main
RAG_DATA_DIRECTORY=./.data
RAG_AUTH_MODE=jwt
RAG_JWT_SECRET=
RAG_JWT_ISSUER=evidence-rag
RAG_JWT_AUDIENCE=evidence-rag-web
# Standalone text Adapter configuration. Not read/enabled by the management app.
# Load explicitly with TextAdapterSettings.load(environmentMap); no automatic network calls.
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_REVISION=
RAG_RERANK_BASE_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_GENERATION_BASE_URL=
RAG_GENERATION_MODEL=
RAG_GENERATION_API_KEY=
RAG_MILVUS_ENDPOINT=
RAG_MILVUS_TOKEN=
RAG_MILVUS_COLLECTION=
RAG_MILVUS_DATABASE=default
RAG_TEXT_DEADLINE_MS=30000
RAG_TEXT_MAX_RESPONSE_BYTES=4194304
RAG_TEXT_ALLOW_LOOPBACK_HTTP=false
