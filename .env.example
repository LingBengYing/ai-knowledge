# Reference only. Spring Boot and run-dev.sh do NOT automatically source .env.
# Supply actual values through your process environment or secret manager.
RAG_ENVIRONMENT=development
RAG_BIND_ADDRESS=127.0.0.1
RAG_PORT=18084
RAG_WORKSPACE_ID=org-main
RAG_DATA_DIRECTORY=./.data
RAG_AUTH_MODE=jwt
RAG_JWT_SECRET=
RAG_JWT_ISSUER=evidence-rag
RAG_JWT_AUDIENCE=evidence-rag-web
# Optional local text model setup. Administrators must be explicit workspace actor IDs.
# Disabled by default; saved private drafts do not replace the active runtime until applied.
# UI selects each role's provider/model/key; provider and Milvus URLs stay server-controlled.
RAG_MODEL_CONFIGURATION_ENABLED=false
RAG_MODEL_CONFIGURATION_ADMINISTRATORS=
RAG_MODEL_CONFIGURATION_PROVIDER_BASE_URL=https://api.siliconflow.cn/v1
RAG_MODEL_CONFIGURATION_DEADLINE_MS=30000
RAG_MODEL_CONFIGURATION_MAX_RESPONSE_BYTES=4194304
RAG_MODEL_CONFIGURATION_ALLOW_LOOPBACK_HTTP=false
RAG_MODEL_CONFIGURATION_RETRIEVAL_TIMEOUT_MS=60000
RAG_MODEL_CONFIGURATION_RETRIEVAL_MAX_CONCURRENT=2
# Indexing or answers load one shared set of model endpoints and Milvus settings when enabled.
# All endpoint/model/key fields are mandatory; indexing uses embedding, answers use all three.
# Loading TextAdapterSettings validates configuration without remote calls; indexing tasks do write.
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_REVISION=
RAG_RERANK_BASE_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_GENERATION_BASE_URL=
RAG_GENERATION_MODEL=
RAG_GENERATION_API_KEY=
RAG_MILVUS_ENDPOINT=
RAG_MILVUS_TOKEN=
RAG_MILVUS_COLLECTION=
RAG_MILVUS_DATABASE=default
RAG_TEXT_DEADLINE_MS=30000
RAG_TEXT_MAX_RESPONSE_BYTES=4194304
RAG_TEXT_ALLOW_LOOPBACK_HTTP=false
# Development-only text ingestion: explicit opt-in and literal loopback binding required.
RAG_INGESTION_ENABLED=false
RAG_INGESTION_PARSE_TIMEOUT_MS=30000
RAG_INGESTION_UPLOAD_TIMEOUT_MS=30000
# Development/test-only text indexing: literal loopback binding and isolated Java collection.
# Independent of ingestion; explicit authorized task required. Parsed/indexed is not answerable.
# Per-claim projection generations and the parent/collection lease are internal, not env inputs.
# The worker requires local POSIX /tmp lease support; process separation is not an OS sandbox.
RAG_INDEXING_ENABLED=false
# Whole indexing task deadline, milliseconds; allowed range 10..600000.
RAG_INDEXING_TIMEOUT_MS=60000
# Development/test-only answer HTTP API; independent of ingestion/indexing, never production-ready.
# Requires existing authorized publications and an existing valid Milvus collection; read-only queries.
RAG_ANSWERS_ENABLED=false
# Whole processing deadline in milliseconds, 10..600000; this is not a slow-request-body timeout.
RAG_ANSWERS_TIMEOUT_MS=60000
# No waiting queue; admission held until actual worker exit. Allowed range 1..8.
RAG_ANSWERS_MAX_CONCURRENT=2
# Local development/test-only document withdrawal; independent of every text/model switch.
# Returns deleting/pending, not physical deletion completion. Does not release stored-byte quota.
RAG_DOCUMENT_REMOVAL_ENABLED=false
# Local image OCR, separate opt-in; no API key and no cloud upload.
# Executable must be an absolute path to an installed Tesseract binary.
# Revision identifies the installed engine and language data, not "latest".
RAG_IMAGE_OCR_ENABLED=false
RAG_IMAGE_OCR_EXECUTABLE=
RAG_IMAGE_OCR_LANGUAGE=eng
RAG_IMAGE_OCR_REVISION=
# Explicit local visual-image flow; requires answers and the existing text/Milvus settings.
# No default provider or credentials; never paste real keys into this file.
RAG_VISUAL_ENABLED=false
RAG_VISION_BASE_URL=
RAG_VISION_MODEL=
RAG_VISION_API_KEY=
RAG_VISION_DEADLINE_MS=30000
RAG_VISION_MAX_RESPONSE_BYTES=262144
RAG_VISION_ALLOW_LOOPBACK_HTTP=false
# Explicit local audio ingestion; requires ingestion, not answers or text model settings.
# Codec paths must be absolute installed FFmpeg/FFprobe executables. Startup makes no ASR requests.
# Upload/parse and explicit indexing are separate; audio answers require RAG_ANSWERS_ENABLED.
RAG_AUDIO_ENABLED=false
RAG_AUDIO_FFMPEG_EXECUTABLE=
RAG_AUDIO_FFPROBE_EXECUTABLE=
# Probe and decode share this deadline, 10..60000 milliseconds.
RAG_AUDIO_DECODE_DEADLINE_MS=30000
# Server sample-aligned chunk boundaries, not word-level timestamps; range 1..30 seconds.
RAG_AUDIO_CHUNK_SECONDS=15
# Whole compilation budget, 10..600000 milliseconds; checked between bounded external stages.
RAG_AUDIO_COMPILATION_BUDGET_MS=600000
# Independent ASR endpoint/model/key; no fallback to text or visual credentials.
RAG_AUDIO_BASE_URL=
RAG_AUDIO_MODEL=
RAG_AUDIO_API_KEY=
RAG_AUDIO_DEADLINE_MS=30000
RAG_AUDIO_MAX_RESPONSE_BYTES=65536
RAG_AUDIO_ALLOW_LOOPBACK_HTTP=false
# Independent local video ingestion; explicit video Content-Type, then a separate index request.
# Video answers also require RAG_ANSWERS_ENABLED; standalone visual/audio switches remain independent.
RAG_VIDEO_ENABLED=false
RAG_VIDEO_FFMPEG_EXECUTABLE=
RAG_VIDEO_FFPROBE_EXECUTABLE=
RAG_VIDEO_DECODE_DEADLINE_MS=30000
RAG_VIDEO_FRAME_INTERVAL_SECONDS=10
RAG_VIDEO_CHUNK_SECONDS=15
RAG_VIDEO_COMPILATION_BUDGET_MS=600000
# Optional OCR of every selected original frame; independent of standalone image OCR enablement.
# OCR uses compiler v2, or v3 when subtitles are enabled. Set an absolute executable and real revision.
RAG_VIDEO_OCR_ENABLED=false
RAG_VIDEO_OCR_EXECUTABLE=
RAG_VIDEO_OCR_LANGUAGE=eng
RAG_VIDEO_OCR_REVISION=
RAG_VIDEO_OCR_DEADLINE_MS=30000
RAG_VIDEO_ASR_BASE_URL=
RAG_VIDEO_ASR_MODEL=
RAG_VIDEO_ASR_API_KEY=
RAG_VIDEO_ASR_DEADLINE_MS=30000
RAG_VIDEO_ASR_MAX_RESPONSE_BYTES=65536
RAG_VIDEO_ASR_ALLOW_LOOPBACK_HTTP=false
RAG_VIDEO_VISION_BASE_URL=
RAG_VIDEO_VISION_MODEL=
RAG_VIDEO_VISION_API_KEY=
RAG_VIDEO_VISION_DEADLINE_MS=30000
RAG_VIDEO_VISION_MAX_RESPONSE_BYTES=262144
RAG_VIDEO_VISION_ALLOW_LOOPBACK_HTTP=false
# Read all supported embedded subtitle tracks; separate from ASR and selected-frame OCR.
# With subtitles enabled, video compilation uses v3. This does not enable synopsis or answers.
RAG_VIDEO_SUBTITLES_ENABLED=false
# Independent local file synopsis; does not enable ingestion/indexing/answers.
# Short and hierarchical generation share these settings. No model requests occur at startup.
RAG_SYNOPSIS_ENABLED=false
RAG_SYNOPSIS_BASE_URL=
RAG_SYNOPSIS_MODEL=
RAG_SYNOPSIS_API_KEY=
RAG_SYNOPSIS_DEADLINE_MS=30000
RAG_SYNOPSIS_MAX_RESPONSE_BYTES=262144
RAG_SYNOPSIS_BUDGET_MS=600000
RAG_SYNOPSIS_ALLOW_LOOPBACK_HTTP=false
# Ephemeral query attachments: explicit local opt-in; requires answers, visual, audio, video and image OCR.
# JSON transport is bounded independently; it does not enable multipart or ingest query originals.
RAG_QUERY_ATTACHMENTS_ENABLED=false
RAG_QUERY_ATTACHMENTS_RECEIVE_TIMEOUT_MS=30000
RAG_QUERY_ATTACHMENTS_MAX_CONCURRENT=2
RAG_QUERY_ATTACHMENTS_OCR_DEADLINE_MS=30000
RAG_QUERY_RANKING_BASE_URL=
RAG_QUERY_RANKING_MODEL=
RAG_QUERY_RANKING_API_KEY=
RAG_QUERY_RANKING_DEADLINE_MS=30000
RAG_QUERY_RANKING_MAX_RESPONSE_BYTES=262144
RAG_QUERY_RANKING_ALLOW_LOOPBACK_HTTP=false
